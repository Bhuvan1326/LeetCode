class Solution {
public:
    int countSpecialIntegers(vector<int>& nums) {
        vector<int> v = nums;
        vector<pair<int, int>> arr;
        for (int i = 0; i < v.size(); i++) {
            arr.push_back({v[i], i});
        }

        sort(arr.begin(), arr.end());
        int ans = 0;
        int n = arr.size();
        int start = 0;
        while (start < n) {
            int end = start;

            while (end < n && arr[end].first == arr[start].first) {
                end++;
            }
            int freq = end - start;
            if (freq >= 3) {
                int diff = arr[start + 1].second - arr[start].second;
                bool valid = true;
                for (int i = start + 2; i < end; i++) {
                    if (arr[i].second - arr[i - 1].second != diff) {
                        valid = false;
                        break;
                    }
                }
                if (valid) {
                    ans++;
                }
            }
            start = end;
        }
        return ans;
    }
};
